# Kopiere diese Datei nach .env (lokal und auf dem Server im App-Ordner) ODER trage die Werte in
# cPanel unter "Setup Node.js App" -> Environment variables ein. Die .env wird NIE eingecheckt.

NODE_ENV=production

# MySQL-Datenbank (bei Namecheap: Host localhost; Name und Benutzer mit cPanel-Praefix, z. B. meinuser_wochenplaner)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=<cpanel-user>_wochenplaner
DB_USER=<cpanel-user>_wochenplaner
DB_PASSWORD=

# Pflicht! Langer Zufallswert, z. B.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Admin-User fuer "npm run seed"
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Optional
# BASE_PATH=/wochenplaner    # nur, wenn die App in einem Unterordner laeuft
# ALLOW_REGISTRATION=false   # oeffentliche Registrierung abschalten
# SEED_DEMO_USER=false       # keinen Demo-Benutzer anlegen

# ---- E-Mail (fuer "Passwort vergessen?") ----
# Oeffentliche Adresse der App (fuer Links in E-Mails und Einladungslinks)
APP_URL=https://wochenplaner.example.com
# SMTP des cPanel-Postfachs: Werte aus cPanel -> Email Accounts -> Connect Devices,
# Kasten "Secure SSL/TLS Settings". Bei Namecheap die Domain selbst als Host, Port 465
# (mail.<domain> hat dort kein passendes Zertifikat).
SMTP_HOST=example.com
SMTP_PORT=465
SMTP_USER=noreply@example.com
SMTP_PASSWORD=
MAIL_FROM=WochenPlaner <noreply@example.com>

# ---- Backup (npm run backup) ----
# BACKUP_DIR=/home/<cpanel-user>/backups/wochenplaner
# BACKUP_KEEP=8
