<%- include('../partials/header') %>
<section class="card form-card">
  <h1><%= recipe ? 'Rezept bearbeiten' : 'Neues Rezept' %></h1>
  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
  <form method="post" action="<%= base %>/recipes<%= recipe ? '/' + recipe.id : '' %>" class="form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Name
      <input type="text" name="name" value="<%= values.name || '' %>" required maxlength="150" placeholder="z. B. Spaghetti Bolognese" <%= recipe ? '' : 'autofocus' %>>
    </label>
    <div class="form-row">
      <label>Portionen
        <input type="number" name="servings" value="<%= values.servings || '' %>" required min="1" max="50" inputmode="numeric">
      </label>
      <label>Tags <span class="hint">mit Komma getrennt</span>
        <input type="text" name="tags" value="<%= values.tags || '' %>" maxlength="255" placeholder="z. B. Vegi, Schnell, Pasta">
      </label>
    </div>
    <label>Zutaten <span class="hint">eine pro Zeile: Menge, Einheit, Zutat – z. B. „200 g Spaghetti“, „1 EL Olivenöl“, „Salz“</span>
      <textarea name="ingredients" rows="10" class="mono" placeholder="400 g Spaghetti&#10;2 Zwiebeln&#10;1 Dose gehackte Tomaten&#10;1 EL Olivenöl&#10;Salz und Pfeffer"><%= values.ingredients_text || '' %></textarea>
    </label>
    <p class="muted small units-hint">Bekannte Einheiten: <%= units.join(', ') %>. Gleiche Zutaten werden auf der Einkaufsliste zusammengezählt.</p>
    <label>Zubereitung <span class="hint">ein Schritt pro Zeile</span>
      <textarea name="instructions" rows="10" maxlength="20000"><%= values.instructions || '' %></textarea>
    </label>
    <label>Link zur Quelle <span class="hint">optional</span>
      <input type="url" name="source_url" value="<%= values.source_url || '' %>" maxlength="500" placeholder="https://…" inputmode="url">
    </label>
    <div class="form-actions">
      <a class="btn btn-ghost" href="<%= base %>/recipes<%= recipe ? '/' + recipe.id : '' %>">Abbrechen</a>
      <button type="submit" class="btn btn-primary">Speichern</button>
    </div>
  </form>
</section>
<%- include('../partials/footer') %>
